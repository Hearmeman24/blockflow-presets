{
  "id": "wan-animate",
  "name": "Wan 2.2 Animate 14B",
  "description": "Wan 2.2 Animate 14B — character-driven video animation with three workflows: Keep Background (animate while preserving the source background), Replace Character (swap the subject), and Replace Face (face-only swap). Lightning I2V distill LoRA + relight LoRA baked in. ~44GB of model files. DWPose (yolox_l + dw-ll) and SAM2 are auto-downloaded by their custom nodes on first run (~1.5 GB extra, not bundled here).",
  "comfygen_min_version": "0.2.0",
  "tags": [
    "i2v",
    "v2v",
    "wan",
    "wan-2.2",
    "wan-animate",
    "animation",
    "character-swap",
    "face-swap"
  ],
